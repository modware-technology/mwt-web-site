# Başlık ayarları (Cloudflare Pages).
# Aynı adrese uyan iki kural aynı başlığı iki kez gönderir; önbellek kuralları bu yüzden çakışmayacak biçimde klasörlere ayrıldı.

# Kart patlatma kareleri ?v= ile çağrılır: bir yıl önbellekte kalabilir
/assets/sequence/*
  Cache-Control: public, max-age=31536000, immutable

# Diğer görseller (logo, ürün görselleri, ikonlar): bir hafta. Görseli değiştirirseniz
# en geç bir hafta içinde herkese yenisi gider; hemen istiyorsanız dosya adını değiştirin.
/assets/urunler/*
  Cache-Control: public, max-age=604800
/assets/hakkimizda/*
  Cache-Control: public, max-age=604800
/assets/logo/*
  Cache-Control: public, max-age=604800
/assets/og/*
  Cache-Control: public, max-age=604800
/assets/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/assets/favicon-192.png
  Cache-Control: public, max-age=604800
/assets/favicon-32.png
  Cache-Control: public, max-age=604800
/assets/favicon.svg
  Cache-Control: public, max-age=604800

# CSS/JS: ?v= sürüm numarasıyla çağrılıyor; bir gün önbellek yeterli
/css/*
  Cache-Control: public, max-age=86400
/js/*
  Cache-Control: public, max-age=86400

# Depo içi belge (README.md) arama motorlarına kapalı
/README.md
  X-Robots-Tag: noindex

# Güvenlik başlıkları
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN