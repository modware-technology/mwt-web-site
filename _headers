# Netlify başlık ayarları
# Kart patlatma kareleri ?v= ile çağrılır: bir yıl önbellekte kalabilir
/assets/sequence/*
  Cache-Control: public, max-age=31536000, immutable

# Diğer görseller (logo, ürün görselleri): bir hafta. Görseli değiştirirseniz
# en geç bir hafta içinde herkese yenisi gider; hemen istiyorsanız dosya adını değiştirin.
/assets/*
  Cache-Control: public, max-age=604800

# CSS/JS: ?v= sürüm numarasıyla çağrılıyor; bir gün önbellek yeterli
/css/*
  Cache-Control: public, max-age=86400
/js/*
  Cache-Control: public, max-age=86400

# Güvenlik başlıkları
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
